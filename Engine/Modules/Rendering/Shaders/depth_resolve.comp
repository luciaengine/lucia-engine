#version 450

// Resolves multisampled depth to R32F. Occlusion uses the farthest sample so a
// pixel with uncovered samples cannot hide geometry behind the covered samples.
layout(constant_id = 0) const int kFarthestTileSize = 1;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DMS uDepthMS;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D uDepthResolved;

void main()
{
    const ivec2 sourceSize = textureSize(uDepthMS);
    const ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(tile, imageSize(uDepthResolved))))
        return;
    const ivec2 first = tile * kFarthestTileSize;
    float depth = texelFetch(uDepthMS, first, 0).r;
    if (kFarthestTileSize > 1)
    {
        const ivec2 last = min(first + kFarthestTileSize, sourceSize);
        const int samples = textureSamples(uDepthMS);
        for (int y = first.y; y < last.y && depth > 0.0; ++y)
            for (int x = first.x; x < last.x && depth > 0.0; ++x)
                for (int sampleIndex = 0; sampleIndex < samples && depth > 0.0; ++sampleIndex)
                    depth = min(depth, texelFetch(uDepthMS, ivec2(x, y), sampleIndex).r);
    }
    imageStore(uDepthResolved, tile, vec4(depth, 0.0, 0.0, 0.0));
}
