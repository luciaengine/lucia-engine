#version 450

// Pack each mesh-major run of rows into a dense indirect-command range.
// Single-instance records move their indirection entry with the command.
// Instanced records retain firstInstance and their prepacked indirection span.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Mirrors GPUDrawStreamBuilder::BatchTableEntry (16 B std430); the slice's
// scatter table, rows sorted by (classKey, orderedMeshAxis | parity).
struct BatchTableEntry {
    uint materialIndex;
    uint meshIndex;      // ordered mesh axis | parity bit 24 (unused here)
    uint recordOffset;   // slice-relative exclusive prefix of capacities
    uint capacity;       // snapshot live-instance count
};

struct VkDrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0, std430) restrict readonly buffer BatchTableBuffer {
    BatchTableEntry batchTable[];
};

// Per-row run map, CPU-built alongside the table (same ring upload — one
// snapshot). x = the run's first row index, y = the run's count-slot index.
layout(set = 0, binding = 1, std430) restrict readonly buffer RowRunBuffer {
    uvec2 rowRun[];
};

// Row cursors count source commands, not instances. Each run count slot
// receives the sum of its member rows for DrawIndexedIndirectCount.
layout(set = 0, binding = 2, std430) restrict coherent buffer BatchCursorsBuffer {
    uint cursors[];
};

layout(set = 0, binding = 3, std430) restrict buffer DrawCommandsBuffer {
    VkDrawIndexedIndirectCommand drawCommands[];
};

layout(set = 0, binding = 4, std430) restrict buffer IndirectionBuffer {
    uint indirection[];
};

layout(push_constant) uniform PushConstants {
    uint recordCount;    // slice capacity domain (snapshotRecords)
    uint rowCount;       // slice table rows
    uint cursorBase;     // arena-absolute base of the slice's row cursors
    uint countBase;      // arena-absolute base of the slice's run count slots
    uint srcRecordBase;  // arena-absolute source command block
    uint dstRecordBase;  // arena-absolute published command block
    // Raw crossfade records are claimed in pairs. Clamp their live prefix to
    // even before copying; an instanced source has already applied this rule.
    uint pairedRecords;
    uint instancedRecords; // instance indirection already resides in the source block
} pc;

uint RowLive(uint row) {
    uint live = min(cursors[pc.cursorBase + row], batchTable[row].capacity);
    return (pc.pairedRecords != 0u) ? (live & ~1u) : live;
}

void main() {
    uint s = gl_GlobalInvocationID.x;
    if (s >= pc.recordCount) {
        return;
    }

    // Row lookup: greatest row with recordOffset <= s. recordOffset[0] == 0,
    // offsets strictly increase (capacity > 0), so lo lands in [1, rowCount].
    uint lo = 0u;
    uint hi = pc.rowCount;
    while (lo < hi) {
        uint mid = (lo + hi) / 2u;
        if (batchTable[mid].recordOffset <= s) {
            lo = mid + 1u;
        } else {
            hi = mid;
        }
    }
    uint row = lo - 1u;
    uint t = s - batchTable[row].recordOffset;
    uint runStart = rowRun[row].x;

    // Run count writer: the run's first capacity slot exists for every run
    // (rows only exist with capacity > 0), whether or not its record is live.
    if (row == runStart && t == 0u) {
        uint total = 0u;
        for (uint i = runStart; i < pc.rowCount && rowRun[i].x == runStart; ++i) {
            total += RowLive(i);
        }
        cursors[pc.countBase + rowRun[row].y] = total;
    }

    if (t >= RowLive(row)) {
        return; // culled hole — never lands in the dense draw block
    }

    // Dense mesh-major destination: run base (the run's first row's capacity
    // prefix — CPU-known, what the publisher's cmdByteOffset points at) plus
    // the live counts of the run's preceding rows.
    uint dstLocal = batchTable[runStart].recordOffset;
    for (uint i = runStart; i < row; ++i) {
        dstLocal += RowLive(i);
    }
    dstLocal += t;

    uint src = pc.srcRecordBase + s;
    uint dst = pc.dstRecordBase + dstLocal;
    VkDrawIndexedIndirectCommand cmd = drawCommands[src];
    if (pc.instancedRecords == 0u) {
        cmd.firstInstance = dst;
        indirection[dst] = indirection[src];
    }
    drawCommands[dst] = cmd;
}
