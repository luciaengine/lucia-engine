<!-- The title occupies the first line; asset selection and override counts occupy the second.
     IDs bind PrefabBar behavior to this layout. -->
<UIElement class="prefab-bar">
  <UIElement id="prefab-bar-title" class="prefab-bar-title">
    <UIElement id="prefab-bar-glyph" class="entity-icon hierarchy-entity-prefab prefab-bar-glyph" />
    <Label id="prefab-bar-title-lead" class="prefab-bar-title-text" />
    <Label id="prefab-bar-prefab" class="prefab-bar-title-text prefab-bar-prefab" />
    <Label id="prefab-bar-title-tail" class="prefab-bar-title-text" />
  </UIElement>
  <UIElement class="prefab-bar-actions">
    <Button id="prefab-bar-select-asset" class="secondary small prefab-bar-select" />
    <UIElement id="prefab-bar-counts" class="prefab-bar-counts">
      <Label id="prefab-bar-count-none" class="prefab-bar-count-none hidden" />
      <Button id="prefab-bar-count" class="prefab-bar-count-button">
        <Label id="prefab-bar-count-text" class="inspector-section-header-badge inspector-section-header-badge-override prefab-bar-count-text" />
      </Button>
      <Button id="prefab-bar-instance-count" class="prefab-bar-count-button">
        <Label id="prefab-bar-instance-count-text" class="inspector-section-header-badge inspector-section-header-badge-override prefab-bar-count-text" />
      </Button>
      <Button id="prefab-bar-stale-count" class="prefab-bar-count-button hidden">
        <Label id="prefab-bar-stale-count-text" class="inspector-section-header-badge prefab-bar-count-text" />
      </Button>
    </UIElement>
  </UIElement>
</UIElement>
