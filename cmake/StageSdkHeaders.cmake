# Synchronize a generated SDK include tree. Source roots are overlaid in order,
# preserving the export order for overlapping paths. Third-party and
# generated headers use their own destination trees, never the public-header union.
include_guard(GLOBAL)

function(ge_stage_sdk_header_tree destination)
    cmake_parse_arguments(PARSE_ARGV 1 _sync "" "" "SOURCES;EXCLUDE_TOP_LEVEL_DIRS")
    if(NOT destination OR _sync_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "ge_stage_sdk_header_tree: destination and valid source arguments are required")
    endif()
    get_filename_component(_destination "${destination}" ABSOLUTE)
    cmake_path(GET _destination ROOT_PATH _root)
    if(_destination STREQUAL _root OR IS_SYMLINK "${_destination}")
        message(FATAL_ERROR "ge_stage_sdk_header_tree: destination must be a generated SDK directory")
    endif()
    file(REAL_PATH "${_destination}" _destination_real)
    foreach(_source IN LISTS _sync_SOURCES)
        if(NOT IS_DIRECTORY "${_source}")
            message(FATAL_ERROR "ge_stage_sdk_header_tree: source directory is missing: ${_source}")
        endif()
        file(REAL_PATH "${_source}" _source_real)
        cmake_path(IS_PREFIX _source_real "${_destination_real}" NORMALIZE _destination_in_source)
        cmake_path(IS_PREFIX _destination_real "${_source_real}" NORMALIZE _source_in_destination)
        if(_destination_in_source OR _source_in_destination)
            message(FATAL_ERROR "ge_stage_sdk_header_tree: source and destination must not overlap")
        endif()
    endforeach()
    foreach(_excluded IN LISTS _sync_EXCLUDE_TOP_LEVEL_DIRS)
        if(NOT _excluded MATCHES "^[A-Za-z0-9_-]+$")
            message(FATAL_ERROR "ge_stage_sdk_header_tree: exclusions must be top-level directory names")
        endif()
    endforeach()

    file(MAKE_DIRECTORY "${_destination}")
    # A generated header tree is self-contained; never write through a link
    # left by a previous export into a source checkout or another SDK.
    cmake_policy(SET CMP0009 NEW)
    file(GLOB_RECURSE _existing LIST_DIRECTORIES true "${_destination}/*")
    foreach(_entry IN LISTS _existing)
        if(IS_SYMLINK "${_entry}")
            file(REMOVE "${_entry}")
        endif()
    endforeach()
    set(SRC_ROOTS "${_sync_SOURCES}")
    set(DST "${_destination}")
    set(FULLY_MANAGED_DST ON)
    set(EXCLUDE_TOP_LEVEL_DIRS "${_sync_EXCLUDE_TOP_LEVEL_DIRS}")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/PruneStagedMirrorOrphans.cmake")
    set(_relative_files "")
    foreach(_source IN LISTS _sync_SOURCES)
        file(GLOB_RECURSE _files FOLLOW_SYMLINKS LIST_DIRECTORIES false
            RELATIVE "${_source}" "${_source}/*")
        foreach(_relative IN LISTS _files)
            string(REGEX REPLACE "/.*$" "" _top_level "${_relative}")
            list(FIND _sync_EXCLUDE_TOP_LEVEL_DIRS "${_top_level}" _excluded_index)
            if(NOT _excluded_index EQUAL -1)
                continue()
            endif()
            string(SHA256 _key "${_relative}")
            set(_winner_${_key} "${_source}/${_relative}")
            list(APPEND _relative_files "${_relative}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _relative_files)
    list(SORT _relative_files)
    foreach(_relative IN LISTS _relative_files)
        # Copy only the winning overlay. Copying an earlier root first would
        # rewrite the final file twice and invalidate an unchanged SDK's seal.
        string(SHA256 _key "${_relative}")
        get_filename_component(_parent "${_destination}/${_relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${_parent}")
        file(COPY_FILE "${_winner_${_key}}" "${_destination}/${_relative}"
            ONLY_IF_DIFFERENT RESULT _result)
        if(NOT _result STREQUAL "0")
            message(FATAL_ERROR "ge_stage_sdk_header_tree: failed copying '${_relative}': ${_result}")
        endif()
    endforeach()

endfunction()
