+
+extension ImageExporter {
+    fileprivate func liveTextureFrame(_ snapshot: ProjectSnapshot) throws -> LuciaLiveTextureFrame {
+        let image = try render(snapshot).image
+        guard let colorSpace = CGColorSpace(name: CGColorSpace.sRGB) else { throw ExportError.render }
+        let rowBytes = image.width * 4
+        var pixels = [UInt8](repeating: 0, count: rowBytes * image.height)
+        try pixels.withUnsafeMutableBytes { storage in
+            let bitmapInfo = CGImageAlphaInfo.premultipliedLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue
+            guard let context = CGContext(data: storage.baseAddress, width: image.width, height: image.height,
+                                          bitsPerComponent: 8, bytesPerRow: rowBytes, space: colorSpace,
+                                          bitmapInfo: bitmapInfo) else { throw ExportError.render }
+            context.draw(image, in: CGRect(x: 0, y: 0, width: image.width, height: image.height))
+            var source = vImage_Buffer(data: storage.baseAddress, height: vImagePixelCount(image.height),
+                                       width: vImagePixelCount(image.width), rowBytes: rowBytes)
+            var destination = source
+            guard vImageUnpremultiplyData_RGBA8888(&source, &destination, vImage_Flags(kvImageNoFlags)) == kvImageNoError
+            else { throw ExportError.render }
+        }
+        return LuciaLiveTextureFrame(pixels: pixels, width: UInt32(image.width), height: UInt32(image.height))
     }
