+#if LUCIA_HOSTED
+import SwiftUI
+
+/// A borderless playback window on the display that contains the Lucia editor.
+@MainActor
+final class HostedViewerWindow: NSWindow {
+    private weak var model: EditorModel?
+    private var priorPresentation: NSApplication.PresentationOptions = []
+
+    init(screen: NSScreen, model: EditorModel) {
+        self.model = model
+        super.init(contentRect: screen.frame, styleMask: .borderless, backing: .buffered, defer: false)
+        isReleasedWhenClosed = false
+        backgroundColor = .black
+        hasShadow = false
+        collectionBehavior = [.fullScreenAuxiliary]
+        contentView = NSHostingView(rootView: PreviewView(model: model))
+        setFrame(screen.frame, display: false)
+    }
+
+    override var canBecomeKey: Bool { true }
+
+    func present(over owner: NSWindow) {
+        priorPresentation = NSApp.presentationOptions
+        NSApp.presentationOptions = [.hideDock, .hideMenuBar]
+        owner.addChildWindow(self, ordered: .above)
+        makeKeyAndOrderFront(nil)
+    }
+
+    func dismiss() {
+        let owner = parent
+        owner?.removeChildWindow(self)
+        orderOut(nil)
+        contentView = nil
+        NSApp.presentationOptions = priorPresentation
+        owner?.makeKey()
+    }
+
+    override func sendEvent(_ event: NSEvent) {
+        if event.type == .keyDown {
+            let modifiers = event.modifierFlags.intersection([.command, .control, .option, .shift])
+            if event.keyCode == 53 || (modifiers.isEmpty && event.charactersIgnoringModifiers == "f") {
+                model?.toggleViewerFullScreen()
+                return
+            }
+        }
+        super.sendEvent(event)
+    }
+}
+#endif
