{
  "name": "lucia-editroom-workspace",
  "version-string": "2026.11.25",
  "port-version": 4,
  "description": "Editroom native workspace for the Lucia Editor",
  "homepage": "https://github.com/robbietilton/Editroom",
  "license": "MIT",
  "supports": "osx & arm64",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
