+#if LUCIA_HOSTED
+/// A hosted media item tracks its own pointer and passes its preview to the visible timeline.
+private struct HostedMediaDragSource: NSViewRepresentable {
+    let thumbnail: () -> NSImage?
+    let payloads: () -> [DragPayload]
+    let click: () -> Void
+    let doubleClick: () -> Void
+
+    func makeNSView(context: Context) -> SourceView { SourceView(frame: .zero) }
+
+    func updateNSView(_ view: SourceView, context: Context) {
+        view.thumbnail = thumbnail
+        view.payloads = payloads
+        view.click = click
+        view.doubleClick = doubleClick
+    }
+
+    @MainActor
+    final class SourceView: NSView {
+        private final class Ghost: NSImageView {
+            override func hitTest(_ point: NSPoint) -> NSView? { nil }
+        }
+
+        var thumbnail: (() -> NSImage?)?
+        var payloads: (() -> [DragPayload])?
+        var click: (() -> Void)?
+        var doubleClick: (() -> Void)?
+
+        private var press: CGPoint?
+        private var dragging: [DragPayload] = []
+        private var ghost: Ghost?
+        private weak var target: TimelineCanvas?
+
+        override func hitTest(_ point: NSPoint) -> NSView? {
+            switch NSApp.currentEvent?.type {
+            case .leftMouseDown, .leftMouseDragged, .leftMouseUp:
+                return super.hitTest(point)
+            default:
+                return nil
+            }
+        }
+
+        override var acceptsFirstResponder: Bool { true }
+        override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
+
+        override func mouseDown(with event: NSEvent) {
+            cancelDrag()
+            press = event.locationInWindow
+        }
+
+        override func mouseDragged(with event: NSEvent) {
+            guard let press, let window, let container = window.contentView else { return }
+            let pointer = event.locationInWindow
+            if dragging.isEmpty {
+                guard hypot(pointer.x - press.x, pointer.y - press.y) >= 4,
+                      let payloads = payloads?(), !payloads.isEmpty else { return }
+                dragging = payloads
+                if let thumbnail = thumbnail?() {
+                    let preview = Ghost(frame: .zero)
+                    preview.image = thumbnail
+                    preview.imageScaling = .scaleProportionallyUpOrDown
+                    preview.alphaValue = 0.82
+                    container.addSubview(preview, positioned: .above, relativeTo: nil)
+                    ghost = preview
+                }
+            }
+
+            let point = container.convert(pointer, from: nil)
+            let width = min(bounds.width, 104)
+            ghost?.frame = CGRect(x: point.x + 8, y: point.y + 8, width: width, height: width * 9 / 16)
+            let timeline = TimelineCanvas.current
+            if let timeline, timeline.window === window,
+               timeline.updateHostedMediaDrop(dragging, at: pointer) {
+                target = timeline
+            } else {
+                target?.cancelHostedMediaDrop()
+                target = nil
+            }
+        }
+
+        override func mouseUp(with event: NSEvent) {
+            if dragging.isEmpty {
+                if event.clickCount >= 2 { doubleClick?() } else { click?() }
+            } else {
+                target?.finishHostedMediaDrop(dragging, at: event.locationInWindow)
+            }
+            cancelDrag()
+        }
+
+        override func viewWillMove(toWindow newWindow: NSWindow?) {
+            if newWindow !== window { cancelDrag() }
+            super.viewWillMove(toWindow: newWindow)
+        }
+
+        private func cancelDrag() {
+            press = nil
+            target?.cancelHostedMediaDrop()
+            target = nil
+            dragging.removeAll()
+            ghost?.removeFromSuperview()
+            ghost = nil
+        }
+    }
+}
+
+#endif
