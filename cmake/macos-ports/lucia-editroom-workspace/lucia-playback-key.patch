+@MainActor
+private final class HostedEditroomView: NSHostingView<HostedEditroom> {
+    private var playbackMonitor: Any?
+
+    func installPlaybackMonitor(for model: EditorModel) {
+        playbackMonitor = NSEvent.addLocalMonitorForEvents(matching: .keyDown) { [weak self, weak model] event in
+            MainActor.assumeIsolated {
+                guard let self, let model, let window = self.window,
+                      !self.isHiddenOrHasHiddenAncestor, !model.viewerOnly else { return event }
+                if let responder = window.firstResponder as? NSView,
+                   responder !== window.contentView, !responder.isDescendant(of: self) {
+                    return event
+                }
+                return KeyCommands.handleHostedPlayback(event, model: model, window: window) ? nil : event
+            }
+        }
+    }
+
+    func removePlaybackMonitor() {
+        if let playbackMonitor {
+            NSEvent.removeMonitor(playbackMonitor)
+            self.playbackMonitor = nil
+        }
+    }
+}
