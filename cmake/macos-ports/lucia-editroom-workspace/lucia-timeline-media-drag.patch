-enum DragPayload: Equatable {
+enum DragPayload: Codable, Equatable {
     case asset(UUID)
     case solid
     case text
+}
+
+/// The pasteboard contract between the SwiftUI Media bin and the AppKit timeline.
+enum TimelineMediaDrag {
+    static let pasteboardType = NSPasteboard.PasteboardType("com.luciaengine.editroom.timeline-media")
+
+    static func provider(for payloads: [DragPayload]) -> NSItemProvider {
+        let data = try? JSONEncoder().encode(payloads)
+        let provider = NSItemProvider()
+        provider.registerDataRepresentation(forTypeIdentifier: pasteboardType.rawValue, visibility: .all) { completion in
+            completion(data, nil)
+            return nil
+        }
+        return provider
+    }
+
+    static func payloads(from pasteboard: NSPasteboard) -> [DragPayload] {
+        guard let data = pasteboard.data(forType: pasteboardType) else { return [] }
+        return (try? JSONDecoder().decode([DragPayload].self, from: data)) ?? []
+    }
 }

