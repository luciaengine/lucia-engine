+
+    private func handleHostedShortcut(_ event: NSEvent) -> Bool {
+        let shortcuts = ShortcutStore.shared
+        guard window?.attachedSheet == nil, shortcuts.recording == nil, !MagicShow.isRunning,
+              let key = KeyCombo(event: event) else { return false }
+
+        if let action = shortcuts.action(for: key) {
+            KeyCommands.perform(action, model)
+            return true
+        }
+        guard !key.command, !key.shift, !key.option, !key.control else { return false }
+        switch key.key {
+        case "j": model.shuttleBackward()
+        case "k": model.pause()
+        case "l": model.play()
+        default: return false
+        }
+        return true
+    }
