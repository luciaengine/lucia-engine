diff --git a/Editroom/App/LuciaWorkspace.swift b/Editroom/App/LuciaWorkspace.swift
new file mode 100644
index 0000000..2b974f2
--- /dev/null
+++ b/Editroom/App/LuciaWorkspace.swift
@@ -0,0 +1,73 @@
+#if LUCIA_HOSTED
+import AppKit
+import SwiftUI
+
+@MainActor
+private struct HostedEditroom: View {
+    @StateObject private var model = EditorModel()
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Button("New", action: model.newProject)
+                Button("Open…", action: model.openProject)
+                Button("Save", action: model.save)
+                Button("Import Media…", action: model.showImportPanel)
+                Spacer()
+                Button("Export…") { model.showExport = true }
+            }
+            .padding(8)
+            ContentView(model: model)
+                .defaultAppStorage(UserDefaults(suiteName: "lucia.workspace.editroom") ?? .standard)
+        }
+    }
+}
+
+
+private enum WorkspaceResources {
+    static var bundle: Bundle = .main
+}
+
+@_cdecl("LuciaCreateMediaWorkspace")
+public func luciaCreateMediaWorkspace(_ bundlePath: UnsafePointer<CChar>) -> UnsafeMutableRawPointer? {
+    MainActor.assumeIsolated {
+        guard let bundle = Bundle(path: String(cString: bundlePath)) else { return nil }
+        WorkspaceResources.bundle = bundle
+        return Unmanaged.passRetained(NSHostingView(rootView: HostedEditroom())).toOpaque()
+    }
+}
+
+@_cdecl("LuciaPlaceMediaWorkspace")
+public func luciaPlaceMediaWorkspace(
+    _ viewHandle: UnsafeMutableRawPointer, _ windowHandle: UnsafeMutableRawPointer?,
+    _ x: Double, _ y: Double, _ width: Double, _ height: Double
+) {
+    MainActor.assumeIsolated {
+        let view = Unmanaged<NSView>.fromOpaque(viewHandle).takeUnretainedValue()
+        guard let windowHandle,
+              let content = Unmanaged<NSWindow>.fromOpaque(windowHandle).takeUnretainedValue().contentView
+        else {
+            view.isHidden = true
+            return
+        }
+        let top = content.isFlipped ? y : content.bounds.height - y - height
+        let frame = NSRect(x: x, y: top, width: width, height: height)
+        if view.superview !== content {
+            view.removeFromSuperview()
+            content.addSubview(view, positioned: .above, relativeTo: nil)
+        }
+        if view.frame != frame { view.frame = frame }
+        view.isHidden = false
+    }
+}
+
+@_cdecl("LuciaDestroyMediaWorkspace")
+public func luciaDestroyMediaWorkspace(_ viewHandle: UnsafeMutableRawPointer) {
+    MainActor.assumeIsolated {
+        let view = Unmanaged<NSView>.fromOpaque(viewHandle).takeRetainedValue()
+        view.removeFromSuperview()
+    }
+}
+
+var luciaWorkspaceResourceBundle: Bundle { WorkspaceResources.bundle }
+#endif
