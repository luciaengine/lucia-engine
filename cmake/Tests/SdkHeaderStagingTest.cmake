cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED SCRIPT OR NOT DEFINED WORK)
    message(FATAL_ERROR "SdkHeaderStagingTest: SCRIPT and WORK are required")
endif()
include("${SCRIPT}")
file(REMOVE_RECURSE "${WORK}")
set(_first "${WORK}/first")
set(_second "${WORK}/second")
set(_sdk "${WORK}/SDK")
file(WRITE "${_first}/Alpha/Keep.h" "keep")
file(WRITE "${_first}/Shared/Overlay.h" "first")
file(WRITE "${_second}/Shared/Overlay.h" "second")
file(WRITE "${_second}/Beta/Rename.h" "rename")
file(WRITE "${_sdk}/include/Removed/Old.h" "old export without a manifest")
file(WRITE "${_sdk}/include-editor/OldEditor.h" "old editor API")
file(WRITE "${_sdk}/lib/DebugFast/Keep.lib" "not headers")
file(WRITE "${_sdk}/templates/Player/Keep.cpp" "not headers")

function(expect_content file expected)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "SdkHeaderStagingTest: missing ${file}")
    endif()
    file(READ "${file}" _actual)
    if(NOT _actual STREQUAL expected)
        message(FATAL_ERROR "SdkHeaderStagingTest: wrong content in ${file}: ${_actual}")
    endif()
endfunction()
function(expect_absent)
    foreach(_file IN LISTS ARGN)
        if(EXISTS "${_file}" OR IS_SYMLINK "${_file}")
            message(FATAL_ERROR "SdkHeaderStagingTest: stale export survived: ${_file}")
        endif()
    endforeach()
endfunction()

# The exported engine tree is the union, with the same last-root overlay rule
# the exporter uses. Old unrecorded headers must disappear on the first export.
set(_roots "${_first};${_second}")
ge_stage_sdk_header_tree("${_sdk}/include" SOURCES ${_roots})
expect_content("${_sdk}/include/Alpha/Keep.h" "keep")
expect_content("${_sdk}/include/Shared/Overlay.h" "second")
expect_content("${_sdk}/include/Beta/Rename.h" "rename")
expect_absent("${_sdk}/include/Removed/Old.h" "${_sdk}/include/Removed")
expect_content("${_sdk}/include-editor/OldEditor.h" "old editor API")
expect_content("${_sdk}/lib/DebugFast/Keep.lib" "not headers")
expect_content("${_sdk}/templates/Player/Keep.cpp" "not headers")

# Unchanged final bytes must preserve timestamps, including an overlaid path.
file(TIMESTAMP "${_sdk}/include/Alpha/Keep.h" _keep_before "%s")
file(TIMESTAMP "${_sdk}/include/Shared/Overlay.h" _overlay_before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
ge_stage_sdk_header_tree("${_sdk}/include" SOURCES ${_roots})
file(TIMESTAMP "${_sdk}/include/Alpha/Keep.h" _keep_after "%s")
file(TIMESTAMP "${_sdk}/include/Shared/Overlay.h" _overlay_after "%s")
if(NOT _keep_before STREQUAL _keep_after OR NOT _overlay_before STREQUAL _overlay_after)
    message(FATAL_ERROR "SdkHeaderStagingTest: unchanged exported bytes were rewritten")
endif()

# Removal of an overlay reveals the earlier root, never deletes its live file.
file(REMOVE "${_second}/Shared/Overlay.h")
file(RENAME "${_second}/Beta/Rename.h" "${_second}/Beta/NewName.h")
ge_stage_sdk_header_tree("${_sdk}/include" SOURCES "${_first}" "${_second}")
expect_content("${_sdk}/include/Shared/Overlay.h" "first")
expect_content("${_sdk}/include/Beta/NewName.h" "rename")
expect_absent("${_sdk}/include/Beta/Rename.h")

# A removed source root cannot strand the root's old exported API.
ge_stage_sdk_header_tree("${_sdk}/include" SOURCES "${_first}")
expect_absent("${_sdk}/include/Beta/NewName.h" "${_sdk}/include/Beta")

# Editor and dependency headers are separate generated trees. The same signing
# exclusions as the real export remove whole obsolete version-like subtrees.
file(WRITE "${_second}/Editor/Live.h" "editor")
ge_stage_sdk_header_tree("${_sdk}/include-editor" SOURCES "${_second}")
expect_absent("${_sdk}/include-editor/OldEditor.h")
expect_content("${_sdk}/include-editor/Editor/Live.h" "editor")
file(WRITE "${_second}/GLES/1.0/Trap.h" "excluded")
file(WRITE "${_sdk}/vcpkg-include/GLES/1.0/Trap.h" "stale signing trap")
file(WRITE "${_sdk}/vcpkg-include/RetiredDependency.h" "stale package")
ge_stage_sdk_header_tree("${_sdk}/vcpkg-include" SOURCES "${_second}"
    EXCLUDE_TOP_LEVEL_DIRS GLES GLSC spirv)
expect_absent("${_sdk}/vcpkg-include/GLES" "${_sdk}/vcpkg-include/RetiredDependency.h")
expect_content("${_sdk}/vcpkg-include/Editor/Live.h" "editor")

# Empty current roots clear only the explicitly owned header destination.
ge_stage_sdk_header_tree("${_sdk}/include-editor" SOURCES)
expect_absent("${_sdk}/include-editor/Editor" "${_sdk}/include-editor/Beta")
expect_content("${_sdk}/lib/DebugFast/Keep.lib" "not headers")
expect_content("${_sdk}/include/Alpha/Keep.h" "keep")

# A leftover SDK link must not turn an export into a source-tree write.
if(NOT CMAKE_HOST_WIN32)
    file(WRITE "${WORK}/external/Keep.h" "external")
    file(REMOVE "${_sdk}/include/Alpha/Keep.h")
    file(CREATE_LINK "${WORK}/external/Keep.h" "${_sdk}/include/Alpha/Keep.h" SYMBOLIC
        RESULT _link_result)
    if(NOT _link_result STREQUAL "0")
        message(FATAL_ERROR "SdkHeaderStagingTest: failed creating symlink fixture: ${_link_result}")
    endif()
    ge_stage_sdk_header_tree("${_sdk}/include" SOURCES "${_first}")
    expect_content("${WORK}/external/Keep.h" "external")
    expect_content("${_sdk}/include/Alpha/Keep.h" "keep")
    if(IS_SYMLINK "${_sdk}/include/Alpha/Keep.h")
        message(FATAL_ERROR "SdkHeaderStagingTest: export retained a source-tree symlink")
    endif()
endif()

# Invalid input must fail before a copy or prune can mutate source or output.
set(_refusal "${WORK}/refuse.cmake")
file(WRITE "${_refusal}" "cmake_minimum_required(VERSION 3.25)\ninclude([==[${SCRIPT}]==])\nge_stage_sdk_header_tree([==[${_first}]==] SOURCES [==[${_first}]==])\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${_refusal}" RESULT_VARIABLE _result
    OUTPUT_QUIET ERROR_QUIET)
if(_result EQUAL 0)
    message(FATAL_ERROR "SdkHeaderStagingTest: overlapping source/destination was accepted")
endif()
expect_content("${_first}/Alpha/Keep.h" "keep")
file(WRITE "${_refusal}" "cmake_minimum_required(VERSION 3.25)\ninclude([==[${SCRIPT}]==])\nge_stage_sdk_header_tree([==[${_sdk}/include]==] SOURCES [==[${WORK}/missing]==])\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${_refusal}" RESULT_VARIABLE _result
    OUTPUT_QUIET ERROR_QUIET)
if(_result EQUAL 0)
    message(FATAL_ERROR "SdkHeaderStagingTest: missing source was accepted")
endif()
expect_content("${_sdk}/include/Alpha/Keep.h" "keep")
file(REMOVE_RECURSE "${WORK}")
message(STATUS "SdkHeaderStagingTest: passed")
