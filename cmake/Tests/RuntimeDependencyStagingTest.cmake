cmake_minimum_required(VERSION 3.25)
foreach(_required SCRIPT WORK GENERATOR C_COMPILER)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "RuntimeDependencyStagingTest: ${_required} is required")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
execute_process(COMMAND "${CMAKE_COMMAND}"
    -S "${CMAKE_CURRENT_LIST_DIR}/RuntimeDependencyStaging" -B "${WORK}"
    -G "${GENERATOR}" -DCMAKE_BUILD_TYPE=Release "-DCMAKE_C_COMPILER=${C_COMPILER}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _output)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "RuntimeDependencyStagingTest: configure failed:\n${_output}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}" --config Release --parallel 2
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _output)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "RuntimeDependencyStagingTest: build failed:\n${_output}")
endif()
include("${WORK}/paths_Release.cmake")
get_filename_component(_stage "${HOST}" DIRECTORY)
file(COPY "${OLD_PARENT}" "${OLD_CHILD}" DESTINATION "${_stage}")
file(COPY "${RETIRED}" DESTINATION "${_stage}")
# This dependency belonged to the old Child, but is no longer imported. A
# stale-table scan must not turn it back into an input of the current host.
get_filename_component(_retired_name "${RETIRED}" NAME)
file(WRITE "${FRESH}/${_retired_name}" "retired producer is not an input")
# Another target shares this runtime directory. Its library is deliberately
# different from its fresh output, and must not be read or replaced by this host.
file(WRITE "${_stage}/${UNRELATED}" "another target's staged library")
file(WRITE "${FRESH}/${UNRELATED}" "another target's fresh library")
set(GE_RUNTIME_DEPS_EXECUTABLE "${HOST}")
set(GE_RUNTIME_DEPS_DEST_DIR "${_stage}")
set(GE_RUNTIME_DEPS_SEARCH_DIRS "${FRESH};${_stage}")
include("${SCRIPT}")
if(_ge_unresolved)
    message(FATAL_ERROR "RuntimeDependencyStagingTest: unresolved current imports: ${_ge_unresolved}")
endif()
file(READ "${_stage}/${UNRELATED}" _unrelated)
if(NOT _unrelated STREQUAL "another target's staged library")
    message(FATAL_ERROR "RuntimeDependencyStagingTest: refreshed an unrelated target's library")
endif()
file(SHA256 "${RETIRED}" _retired_expected)
file(SHA256 "${_stage}/${_retired_name}" _retired_actual)
if(NOT _retired_actual STREQUAL _retired_expected)
    message(FATAL_ERROR "RuntimeDependencyStagingTest: refreshed a retired import")
endif()
foreach(_name "${PARENT}" "${CHILD}" "${LEAF}")
    if(NOT EXISTS "${_stage}/${_name}")
        message(FATAL_ERROR "RuntimeDependencyStagingTest: missing new transitive import: ${_name}")
    endif()
    file(SHA256 "${_stage}/${_name}" _actual)
    file(SHA256 "${FRESH}/${_name}" _expected)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "RuntimeDependencyStagingTest: stale dependency: ${_name}")
    endif()
endforeach()
# No probe application is launched; all evidence comes from native import
# scans and the staged binary bytes, including a new grandchild dependency.
file(REMOVE_RECURSE "${WORK}")
message(STATUS "RuntimeDependencyStagingTest: passed")
