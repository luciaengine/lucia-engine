# Records the actual child-process arguments of both manifest installers.
# No compiler, package installer or network is used.
if(NOT DEFINED SCRIPT OR NOT DEFINED WORK)
    message(FATAL_ERROR "VcpkgManifestInstallTest.cmake: SCRIPT and WORK are required")
endif()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/manifest root" "${WORK}/vcpkg root"
    "${WORK}/packages/concurrentqueue" "${WORK}/packages/nlohmann_json"
    "${WORK}/packages/benchmark")
foreach(package IN ITEMS concurrentqueue nlohmann_json benchmark)
    file(WRITE "${WORK}/packages/${package}/${package}Config.cmake"
        "set(${package}_FOUND TRUE)\n")
endforeach()

file(WRITE "${WORK}/record-vcpkg.cmake" [==[
file(GLOB calls "${RECORD_DIRECTORY}/call-*.txt")
list(LENGTH calls count)
set(record "${RECORD_DIRECTORY}/call-${count}.txt")
set(started FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(index RANGE 0 ${last})
    set(argument "${CMAKE_ARGV${index}}")
    if(argument STREQUAL "install")
        set(started TRUE)
    endif()
    if(started)
        string(LENGTH "${argument}" length)
        file(APPEND "${record}" "${length}:${argument}\n")
    endif()
endforeach()
file(WRITE "${RECORD_DIRECTORY}/compiler-environment.txt" "$ENV{CC}\n$ENV{CXX}\n")
if(FAIL_INSTALL)
    message(FATAL_ERROR "recording vcpkg: requested install failure")
endif()
]==])

