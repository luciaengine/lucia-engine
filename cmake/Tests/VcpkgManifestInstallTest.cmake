function(check_case entrypoint rootMode failInstall missingPackage optionalMode)
    set(case "${entrypoint}-${rootMode}-${failInstall}-${missingPackage}-${optionalMode}")
    set(records "${WORK}/records/${case}")
    file(MAKE_DIRECTORY "${records}")
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DENTRYPOINT=${entrypoint}"
            "-DROOT_MODE=${rootMode}" "-DFAIL_INSTALL=${failInstall}"
            "-DMISSING_PACKAGE=${missingPackage}" "-DRECORD_DIRECTORY=${records}"
            "-DOPTIONAL_MODE=${optionalMode}"
            -P "${WORK}/fixture.cmake"
        WORKING_DIRECTORY "${WORK}/manifest root"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(expectedFailure "${failInstall}")
    if(NOT missingPackage STREQUAL ""
       AND NOT (missingPackage STREQUAL "benchmark" AND optionalMode STREQUAL "minimal"))
        set(expectedFailure ON)
    endif()
    if(expectedFailure)
        if(result EQUAL 0)
            message(FATAL_ERROR "${case}: failure was not propagated:\n${output}${error}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${case}: manifest invocation failed (${result}):\n${output}${error}")
    endif()

    file(GLOB calls "${records}/call-*.txt")
    list(LENGTH calls count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${case}: expected one manifest call, got ${count}; no fallback install is allowed")
    endif()
    if(rootMode STREQUAL "explicit")
        set(installRoot "${WORK}/explicit install")
    elseif(rootMode STREQUAL "toolchain")
        set(installRoot "${WORK}/toolchain install")
    else()
        set(installRoot "${WORK}/build root/vcpkg_installed")
    endif()
    set(expectedArguments install --triplet x64-steamdeck
        "--vcpkg-root=${WORK}/vcpkg root" --x-wait-for-lock
        "--x-manifest-root=${WORK}/manifest root" "--x-install-root=${installRoot}"
        --clean-buildtrees-after-build --clean-packages-after-build)
    if(NOT optionalMode STREQUAL "defaults")
        list(APPEND expectedArguments
            --feature-flags=manifests,binarycaching --host-triplet=x64-linux)
        if(NOT optionalMode STREQUAL "false-overlays")
            list(APPEND expectedArguments
                "--overlay-ports=${WORK}/ports first" "--overlay-ports=${WORK}/ports second"
                "--overlay-triplets=${WORK}/triplets first" "--overlay-triplets=${WORK}/triplets second")
        endif()
        if(NOT optionalMode STREQUAL "minimal")
            list(APPEND expectedArguments --x-feature=video --x-feature=tests)
        endif()
        list(APPEND expectedArguments --x-no-default-features
            --only-binarycaching --no-downloads
            "--x-write-nuget-packages-config=${WORK}/plan path/plan.config")
    endif()
    set(expected "")
    foreach(argument IN LISTS expectedArguments)
        string(LENGTH "${argument}" length)
        string(APPEND expected "${length}:${argument}\n")
    endforeach()
    file(READ "${records}/call-0.txt" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${case}: child policy arguments differ:\n${actual}\nExpected:\n${expected}")
    endif()
    if(CMAKE_HOST_WIN32)
        set(expectedCompilers "\n\n")
    else()
        set(expectedCompilers "${WORK}/held compiler/cc\n${WORK}/held compiler/c++\n")
    endif()
    file(READ "${records}/compiler-environment.txt" actualCompilers)
    if(NOT actualCompilers STREQUAL expectedCompilers)
        message(FATAL_ERROR "${case}: held host compiler environment was not preserved")
    endif()
endfunction()

foreach(entrypoint IN ITEMS install verify)
    foreach(rootMode IN ITEMS explicit toolchain default)
        check_case("${entrypoint}" "${rootMode}" OFF "" populated)
    endforeach()
    check_case("${entrypoint}" explicit ON "" populated)
    check_case("${entrypoint}" explicit OFF "" defaults)
    check_case("${entrypoint}" explicit OFF "" false-overlays)
endforeach()
check_case(verify explicit OFF nlohmann_json populated)
check_case(verify explicit OFF benchmark populated)
check_case(verify explicit OFF benchmark minimal)
message(STATUS "VcpkgManifestInstallTest: all 15 cases passed")
