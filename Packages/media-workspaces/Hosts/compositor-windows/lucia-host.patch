+bool MainWindow::openLuciaTexture(const QString& path){
+    auto image=QImage(path).convertToFormat(QImage::Format_RGBA8888_Premultiplied);
+    if(image.isNull())return false;
+    try{
+        Document document;
+        document.id=newId();document.width=image.width();document.height=image.height();
+        Layer layer;layer.id=newId();layer.name=QFileInfo(path).completeBaseName().toStdString();
+        layer.transform.width=image.width();layer.transform.height=image.height();
+        layer.raster=Raster::fromRgba(image.width(),image.height(),image.constBits(),size_t(image.bytesPerLine()));
+        document.layers.push_back(std::move(layer));
+        addProject(std::move(document),QFileInfo(path).completeBaseName(),true);
+        return true;
+    }catch(const std::exception& error){
+        QMessageBox::warning(this,"Live Texture",QString::fromUtf8(error.what()));
+        return false;
+    }
+}
