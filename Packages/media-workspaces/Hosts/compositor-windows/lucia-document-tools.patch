+QString MainWindow::luciaCreateCanvas(int width, int height)
+{
+    auto* project = current();
+    if (!project || project->document || project->importing || project->projectBusy)
+        return {};
+    Document document;
+    document.id = newId();
+    document.width = width;
+    document.height = height;
+    Layer layer;
+    layer.id = newId();
+    layer.name = "Layer 1";
+    layer.transform = {0, 0, double(width), double(height)};
+    document.layers.push_back(layer);
+    try
+    {
+        validateDocument(document);
+    }
+    catch (const std::exception&)
+    {
+        return {};
+    }
+    project->history.begin("New Canvas", std::nullopt, {});
+    project->document = std::move(document);
+    project->active = layer.id;
+    project->selected = {layer.id};
+    project->history.end(project->document, project->active);
+    refresh();
+    project->canvas->fit();
+    return QString::fromStdString(project->document->id);
+}
