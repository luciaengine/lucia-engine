+bool MainWindow::luciaRenameLayer(const QString& id, const QString& name)
+{
+    auto* project = current();
+    if (!project || !project->document || project->projectBusy || project->importing)
+        return false;
+    const auto layerId = id.toStdString();
+    const auto layer = std::ranges::find(project->document->layers, layerId, &Layer::id);
+    if (layer == project->document->layers.end())
+        return false;
+    try
+    {
+        edit("Rename Layer", [&layerId, &name](Document& document) {
+            const auto target = std::ranges::find(document.layers, layerId, &Layer::id);
+            if (target != document.layers.end())
+                target->name = name.toStdString();
+        });
+    }
+    catch (const std::exception&)
+    {
+        return false;
+    }
+    return true;
+}
