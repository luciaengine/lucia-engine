diff --git a/src/ui/MainWindow.cpp b/src/ui/MainWindow.cpp
index 9b29c14..b9798b2 100644
--- a/src/ui/MainWindow.cpp
+++ b/src/ui/MainWindow.cpp
@@ -7919,0 +7920,21 @@ void MainWindow::exportPng(bool jpegDefault)
+bool MainWindow::openLuciaTexture(const QString &path)
+{
+    QString error;
+    const QImage image = ImageImporter::read(path, &error);
+    EditorSession opened;
+    if (image.isNull() || !opened.insertImage(image, QFileInfo(path).completeBaseName())) {
+        showMessage(this, tr("Could Not Open Texture"), error.isEmpty() ? tr("Could not read the project PNG.") : error);
+        return false;
+    }
+    opened.setDocument(opened.document());
+    if (workspaceTabs_.size() == 1 && !document_) {
+        session_ = std::move(opened);
+        workspaceTabs_[0] = session_;
+        syncDocumentViews();
+    } else {
+        installInNewTab(std::move(opened), QFileInfo(path).completeBaseName());
+    }
+    canvas_->fitCanvas();
+    return true;
+}
+
