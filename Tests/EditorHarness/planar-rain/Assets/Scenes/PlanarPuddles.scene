[scene name="PlanarPuddles" version=1]


; Flat wet ground with a shader-authored mask, damp banks and dielectric water.
; PuddleGround's Use Mask Texture switches to a custom grayscale texture.
; No spherical mirror geometry or reflection probes are used.

