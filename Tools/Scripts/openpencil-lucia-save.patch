@@ -0,0 +1,29 @@
+type LuciaSaveBridge = {
+  postMessage(data: { filename: string; contents: string }): Promise<string | null>
+}
+
+export function luciaSaveBridge(): LuciaSaveBridge | undefined {
+  if (window.location.origin !== 'lucia-app://editor') return undefined
+  const host = window as Window & {
+    webkit?: { messageHandlers?: { luciaSaveDocument?: LuciaSaveBridge } }
+  }
+  return host.webkit?.messageHandlers?.luciaSaveDocument
+}
+
+export async function saveThroughLucia(
+  bridge: LuciaSaveBridge,
+  filename: string,
+  stream: ReadableStream<Uint8Array>
+): Promise<string | null> {
+  const blob = await new Response(stream).blob()
+  const contents = await new Promise<string>((resolve, reject) => {
+    const reader = new FileReader()
+    reader.onerror = () => reject(reader.error)
+    reader.onload = () => {
+      const dataURL = reader.result as string
+      resolve(dataURL.slice(dataURL.indexOf(',') + 1))
+    }
+    reader.readAsDataURL(blob)
+  })
+  return bridge.postMessage({ filename, contents })
+}
