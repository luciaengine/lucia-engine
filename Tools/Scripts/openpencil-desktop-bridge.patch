+type CloseChoice = 'save' | 'discard' | 'cancel'
+type NativeMessage = { id: number; value?: unknown; error?: string }
+type LuciaWindow = Window & {
+  webkit?: { messageHandlers?: {
+    luciaSaveDocument?: LuciaSaveBridge
+    luciaChooseDocumentClose?: { postMessage(name: string): Promise<CloseChoice> }
+  } }
+  chrome?: { webview?: {
+    postMessage(message: unknown): void
+    addEventListener(name: 'message', receive: (event: MessageEvent<NativeMessage>) => void): void
+    removeEventListener(name: 'message', receive: (event: MessageEvent<NativeMessage>) => void): void
+  } }
+}
+
+function luciaWebKit() {
+  if (window.location.protocol !== 'lucia-app:' || window.location.host !== 'editor') return undefined
+  return (window as LuciaWindow).webkit?.messageHandlers
+}
+
+function luciaWebView2() {
+  if (window.location.origin !== 'https://lucia-editor.invalid') return undefined
+  return (window as LuciaWindow).chrome?.webview
+}
+
+let nextMessage = 0
+function sendWebView2<T>(
+  host: NonNullable<ReturnType<typeof luciaWebView2>>,
+  kind: string,
+  payload: unknown
+): Promise<T> {
+  const id = ++nextMessage
+  return new Promise((resolve, reject) => {
+    function receive(event: MessageEvent<NativeMessage>) {
+      if (event.data?.id !== id) return
+      host.removeEventListener('message', receive)
+      if (event.data.error) reject(new Error(event.data.error))
+      else resolve(event.data.value as T)
+    }
+    host.addEventListener('message', receive)
+    try {
+      host.postMessage({ id, kind, payload })
+    } catch (error) {
+      host.removeEventListener('message', receive)
+      reject(error)
+    }
+  })
+}
