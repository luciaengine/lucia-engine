 import { isPastPointerDragThreshold } from '#vue/shared/input/drag-threshold'
 import type { DragMarquee } from '#vue/shared/input/types'
+
+interface MarqueeTarget {
+  id: string
+  bounds: Rect
+  enclose: boolean
+}
+
+interface MarqueeTargets {
+  graph: Editor['graph']
+  parentId: string
+  insideContainer: boolean
+  sceneVersion: number
+  previewVersion: number
+  targets: MarqueeTarget[]
+}
+
+const targetsByDrag = new WeakMap<DragMarquee, MarqueeTargets>()
+
+function getMarqueeTargets(editor: Editor, drag: DragMarquee): MarqueeTarget[] {
+  const graph = editor.graph
+  const scopeId = drag.containerId ?? editor.state.enteredContainerId
+  const parentId = scopeId ?? editor.state.currentPageId
+  const insideContainer = !!scopeId
+  const sceneVersion = editor.state.sceneVersion
+  const previewVersion = graph.positionPreviewVersion
+  const cached = targetsByDrag.get(drag)
+  if (cached?.graph === graph && cached.parentId === parentId &&
+    cached.insideContainer === insideContainer && cached.sceneVersion === sceneVersion &&
+    cached.previewVersion === previewVersion) return cached.targets
+
+  // Bounds stay valid while only the pointer moves. A document or geometry preview change
+  // makes candidates resolve again, including changes arriving from a collaborator.
+  const targets: MarqueeTarget[] = []
+  for (const node of graph.getChildren(parentId)) {
+    if (!node.visible || node.locked) continue
+    targets.push({
+      id: node.id,
+      bounds: getAxisAlignedWorldBounds(node, graph),
+      enclose: !insideContainer && graph.isOpenContainer(node.id)
+    })
+  }
+  targetsByDrag.set(drag, { graph, parentId, insideContainer, sceneVersion, previewVersion, targets })
+  return targets
+}

 function intersects(a: Rect, b: Rect) {
