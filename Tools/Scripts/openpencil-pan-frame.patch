@@ -0,0 +1,17 @@
+import type { Editor } from '@open-pencil/core'
+
+const NAVIGATION_SETTLE_DELAY_MS = 120
+const pendingSettles = new WeakMap<Editor, ReturnType<typeof setTimeout>>()
+
+/** Retain the moving viewport's render budget until the pointer has been still briefly. */
+export function settleCanvasNavigation(editor: Editor) {
+  const previous = pendingSettles.get(editor)
+  if (previous !== undefined) clearTimeout(previous)
+  editor.setNavigationPhase('settling')
+  pendingSettles.set(editor, setTimeout(() => {
+    pendingSettles.delete(editor)
+    if (editor.state.navigation.phase !== 'settling') return
+    editor.setNavigationPhase('idle')
+    editor.requestRepaint()
+  }, NAVIGATION_SETTLE_DELAY_MS))
+}
