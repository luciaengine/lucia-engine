FROM docker.io/library/debian:trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config python3 autoconf autoconf-archive automake libtool \
    git curl ca-certificates zip unzip tar libxinerama-dev libxcursor-dev xorg-dev libglu1-mesa-dev libwayland-dev \
    mesa-vulkan-drivers vulkan-tools vulkan-validationlayers libvulkan1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=mcr.microsoft.com/dotnet/sdk:10.0 /usr/share/dotnet /usr/share/dotnet
RUN ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet && apt-get update && apt-get install -y --no-install-recommends libicu76 && rm -rf /var/lib/apt/lists/*
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
WORKDIR /lucia
